<!-- LEAP Hand (Left-Handed)

##################
Naming Conventions
##################

* Finger phalanges: {bs, px, md, ds} denote {base, proximal, middle, distal} phalanges.
* Thumb phalances: {mp, bs, px, ds} denote {metacarpal, base, proximal, distal} phalanges.

|========|===========|
| BODY # | BODY NAME |
|========|===========|
|  PALM  |   palm    |
|========|===========|
|   0    |   if_bs   |
|   1    |   if_px   |
|   2    |   if_md   |
|   3    |   if_ds   |
|========|===========|
|   4    |   mf_bs   |
|   5    |   mf_px   |
|   6    |   mf_md   |
|   7    |   mf_ds   |
|========|===========|
|   8    |   rf_bs   |
|   9    |   rf_px   |
|   10   |   rf_md   |
|   11   |   rf_ds   |
|========|===========|
|   12   |   th_mp   |
|   13   |   th_bs   |
|   14   |   th_px   |
|   15   |   th_ds   |
|========|===========|

* Finger joints: {mcp, rot, pip, dip} denote {metacarpophalangeal, rotational, proximal interphalangeal, distal interphalangeal} joints.
* Thumb joints: {cmc, axl, mcp, ipl} denote {carpometacarpal, axial, metacarpophalangeal, interphalangeal} joints.

|=========|============|
| JOINT # | JOINT NAME |
|=========|============|
|    0    |   joint_0  |
|    1    |   joint_1  |
|    2    |   joint_2  |
|    3    |   joint_3  |
|=========|============|
|    4    |   joint_4  |
|    5    |   joint_5  |
|    6    |   joint_6  |
|    7    |   joint_7  |
|=========|============|
|    8    |   joint_8  |
|    9    |   joint_9  |
|    10   |   joint_10 |
|    11   |   joint_11 |
|=========|============|
|    12   |   joint_12 |
|    13   |   joint_13 |
|    14   |   joint_14 |
|    15   |   joint_15 |
|=========|============|

-->

<mujoco model="leap_lh">
  <compiler angle="radian" meshdir="./assets/"/>
  <option integrator="implicitfast" cone="elliptic" impratio="100"/>

  <asset>
    <material name="black" rgba="0.2 0.2 0.2 1" />
    <material name="white" rgba="1 1 1 1" />

    <!-- Only tip meshes needed (used as collision geoms) -->
    <mesh name="tip" file="M2826_tip.obj"/>
    <mesh name="thumb_tip" file="M2826_thumb_tip.obj"/>
  </asset>

  <!-- defaults -->
  <default>
    <!-- Contact time constant raised 0.004 -> 0.01 (= 2*timestep, the MuJoCo
    stability floor; mjlab uses exactly this on its grasp pads). Below 2*dt the
    solver can't resolve the contact in one step, which reads as bounce/jitter. -->
    <geom solimp="0.99 0.99 0.002 0.0001 1" solref="0.01 1" friction=".2"/>

    <!-- actuator defaults: kv/damping raised to absorb commanded-target oscillation -->
    <position kp="3.0" kv="0.04" />
    <joint damping="0.06" frictionloss="0.001"/>

    <!-- geom class defaults -->
    <!-- Finger/palm contact surfaces: this is the class the distal/medial
    phalanx pads use -- the geoms that actually press on a grasped object -- so
    they get a grippy slide friction (1.0) instead of the slippery 0.2 default.
    Kept at condim=3 / no priority on purpose: condim=6 + priority=1 (hand
    torsional/rolling governs) made grip WORSE for these flat box-vs-box pads --
    it modeled near-frictionless roll/spin, letting objects twist out. condim=3
    lets the multi-point slide friction resist twist naturally. -->
    <default class="collision">
      <geom material="black" friction="1.0" />
    </default>
    <!-- Fingertip end caps: grippy slide friction, condim=3 like the pads
    (see the collision class note above re: why not condim=6 + priority). -->
    <default class="tip">
      <geom type="mesh" mesh="tip" friction="1.0" material="white" />
    </default>
    <default class="thumb_tip">
      <geom type="mesh" mesh="thumb_tip" friction="1.0" material="white" />
    </default>

    <!-- joint class defaults -->
    <default class="mcp">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-0.314 2.23" />
      <position ctrlrange="-0.314 2.23" />
    </default>
    <default class="rot">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-1.047 1.047" />
      <position ctrlrange="-1.047 1.047" />
    </default>
    <default class="pip">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-0.506 1.885" />
      <position ctrlrange="-0.506 1.885" />
    </default>
    <default class="dip">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-0.366 2.042" />
      <position ctrlrange="-0.366 2.042" />
    </default>
    <default class="thumb_cmc">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-2.443 0.47" />
      <position ctrlrange="-2.443 0.47" />
    </default>
    <default class="thumb_axl">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-2.094 0.349" />
      <position ctrlrange="-2.094 0.349" />
    </default>
    <default class="thumb_mcp">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-1.20 1.90" />
      <position ctrlrange="-1.20 1.90" />
    </default>
    <default class="thumb_ipl">
      <joint pos="0 0 0" axis="0 0 -1"
        limited="true" range="-1.34 1.88" />
      <position ctrlrange="-1.34 1.88" />
    </default>
  </default>

  <!-- collision filtering -->
  <contact>
    <!-- filter the palm from all other finger bodies except the tips -->
    <exclude body1="palm" body2="if_bs" />
    <exclude body1="palm" body2="mf_bs" />
    <exclude body1="palm" body2="rf_bs" />
    <exclude body1="palm" body2="th_mp" />

    <exclude body1="palm" body2="if_px" />
    <exclude body1="palm" body2="mf_px" />
    <exclude body1="palm" body2="rf_px" />
    <exclude body1="palm" body2="th_bs" />

    <exclude body1="palm" body2="if_md" />
    <exclude body1="palm" body2="mf_md" />
    <exclude body1="palm" body2="rf_md" />
    <exclude body1="palm" body2="th_px" />

    <!-- none of the base fingertip geoms can touch each other -->
    <exclude body1="if_bs" body2="mf_bs" />
    <exclude body1="if_bs" body2="rf_bs" />
    <exclude body1="mf_bs" body2="rf_bs" />

    <exclude body1="th_mp" body2="if_bs" />
    <exclude body1="th_mp" body2="mf_bs" />
    <exclude body1="th_mp" body2="rf_bs" />
  </contact>

